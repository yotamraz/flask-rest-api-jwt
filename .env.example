# Application settings
DEBUG=False
SECRET_KEY=your-secret-key-change-me

# Database URI
# For development with SQLite (async):
SQLALCHEMY_DATABASE_URI=sqlite+aiosqlite:///./data-dev.sqlite
# For production with PostgreSQL (async):
# SQLALCHEMY_DATABASE_URI=postgresql+asyncpg://user:password@db:5432/appdb

# JWT settings
ACCESS_TOKEN_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_DAYS=30
