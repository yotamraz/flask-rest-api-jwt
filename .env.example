# Application Settings
DEBUG=True
SECRET_KEY=your-secret-key-change-me

# Database URI (async driver required)
# For SQLite (development): sqlite+aiosqlite:///./data-dev.sqlite
# For PostgreSQL (production): postgresql+asyncpg://user:password@db:5432/appdb
SQLALCHEMY_DATABASE_URI=sqlite+aiosqlite:///./data-dev.sqlite

# JWT Settings
ACCESS_TOKEN_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_DAYS=30
