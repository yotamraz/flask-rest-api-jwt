# Application secret key (change this in production!)
SECRET_KEY=your-secret-key-change-me

# Database URI (async driver required)
# For local development with SQLite:
SQLALCHEMY_DATABASE_URI=sqlite+aiosqlite:///./data-dev.sqlite
# For PostgreSQL (production/Docker):
# SQLALCHEMY_DATABASE_URI=postgresql+asyncpg://user:password@db:5432/appdb

# JWT token expiration settings
ACCESS_TOKEN_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_DAYS=30

# Debug mode
DEBUG=false
